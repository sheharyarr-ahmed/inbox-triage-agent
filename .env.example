# Copy to .env.local and fill in. .env.local is git-ignored; this file is not.
# Never `export ANTHROPIC_API_KEY` in a shell that also runs `claude` — a
# globally visible key makes Claude Code bill API credits instead of the Max
# subscription, which breaks the billing boundary this project depends on.
# src/config.ts validates every key below on load.

# --- Credentials -----------------------------------------------------------
# Workspace-scoped key from the Console. Used by the `ant` CLI (in a per-command
# environment, never --api-key, which is visible in `ps`) and by the SDK via
# dotenv.
#
# THIS KEY IS NOT SPEND-CAPPED. Through Phase 6 the workspace carried a $5 hard
# limit that made overspend structurally impossible — requests were refused at
# the cap. The operator removed it on 2026-08-05. Keys still cannot move between
# workspaces, so this one cannot reach another workspace's spend, but the bound
# is now the organization credit balance. `--budget` on every live run and the
# per-ticket wall clock are what replaced it, and both are discipline rather
# than physics. See SPEC § Cost controls.
ANTHROPIC_API_KEY=

# Console → workspace settings.
ANTHROPIC_WORKSPACE_ID=

# --- MCP server (Phase 1) --------------------------------------------------
# Bearer token you generate. mcp-server/src/auth.ts rejects any request whose
# Authorization header does not match it. The same value is stored as the
# vault `static_bearer` credential so the token never enters the sandbox.
MCP_SERVER_TOKEN=

# The deployed Vercel endpoint, e.g. https://<deploy>.vercel.app/mcp
# Must match the vault credential's mcp_server_url and agent.yaml's
# mcp_servers[].url.
MCP_SERVER_URL=

# --- Control plane: `ant` CLI (Phase 2) ------------------------------------
# ant beta:environments create < agent/environment.yaml --transform id -r
ENVIRONMENT_ID=

# ant beta:agents create < agent/agent.yaml --transform id -r
AGENT_ID=

# Pin sessions to a known-good agent version for reproducibility.
AGENT_VERSION=

# --- Data plane: src/deploy.ts ---------------------------------------------
# POST /v1/skills from agent/skills/triage/. Both are substituted into
# agent/agent.yaml by scripts/apply-control-plane.sh.
TRIAGE_SKILL_ID=

# Pinned rather than `latest`, so a session is reproducible. The value is an
# epoch-timestamp string such as 1759178010641129 — NOT "1" as SPEC § Runtime
# configuration states (skills-guide.md:50). See amendment A-9.
TRIAGE_SKILL_VERSION=
# sha256 of agent/skills/triage/SKILL.md as uploaded. `pnpm provision` refuses to
# report "already provisioned" when the local file no longer matches it — skills
# are immutable, so an edit that never got a new version leaves every live run
# measuring the OLD procedure. Written by `pnpm provision --new-skill-version`.
TRIAGE_SKILL_SHA256=

# vaults.create, then a static_bearer credential keyed to MCP_SERVER_URL.
VAULT_ID=

# memoryStores.create. Attaches at session creation only.
MEMORY_STORE_ID=

# agent/rubric.md uploaded once through the Files API, so all ten sessions
# grade against a byte-identical document.
RUBRIC_FILE_ID=
